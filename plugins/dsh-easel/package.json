{
  "name": "dsh-easel",
  "version": "0.4.0",
  "private": true,
  "description": "DSH bundle: the Creator Workbench panel for the Easel creator toolchain — reuses Easel's skills, Python scripts and data directories inside DeepSeek Harness.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "assets",
    "scripts",
    "test",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build-client.mjs --check && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "easel",
    "creator-workbench",
    "content-calendar",
    "publishing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keeliu/Easel.git",
    "directory": "plugins/dsh-easel"
  }
}
